<resources>
    <color name="background">#F5F5F7</color>
    <color name="cardBackground">#FFFFFF</color>
    <color name="cardStroke">#E1E1E4</color>
    <color name="timerText">#0288D1</color>
    <color name="labelText">#5F5F63</color>
    <color name="sectionHeader">#8A8A8E</color>
    <color name="statusOn">#2E7D32</color>
    <color name="statusOff">#EF6C00</color>
