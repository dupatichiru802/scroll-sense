<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.OverlayTimer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorAccent">@color/timerText</item>
        <item name="materialButtonStyle">@style/Widget.OverlayTimer.Button</item>
    </style>

    <style name="Widget.OverlayTimer.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">24dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">15sp</item>
        <item name="backgroundTint">?attr/colorAccent</item>
        <item name="android:textColor">@color/background</item>
    </style>

    <style name="Widget.OverlayTimer.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">24dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">15sp</item>
        <item name="strokeColor">?attr/colorAccent</item>
        <item name="android:textColor">?attr/colorAccent</item>
    </style>

    <style name="TextAppearance.OverlayTimer.SectionHeader" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textColor">@color/sectionHeader</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="TextAppearance.OverlayTimer.SectionHeading" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textColor">?attr/colorAccent</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="MessageOptionRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/toggle_option_background</item>
        <item name="android:textColor">@color/toggle_option_text</item>
        <item name="android:padding">14dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Overridden at runtime via theme.applyStyle() based on the selected bubble
         colour, so the app's own UI matches the overlay bubble, not just the accent
         used inside the floating bubble itself. -->
    <style name="ThemeOverlay.OverlayTimer.Blue" parent=""><item name="colorAccent">@color/bubbleColorBlueLight</item></style>
    <style name="ThemeOverlay.OverlayTimer.Orange" parent=""><item name="colorAccent">@color/bubbleColorOrangeLight</item></style>
    <style name="ThemeOverlay.OverlayTimer.Green" parent=""><item name="colorAccent">@color/bubbleColorGreenLight</item></style>
    <style name="ThemeOverlay.OverlayTimer.Purple" parent=""><item name="colorAccent">@color/bubbleColorPurpleLight</item></style>
    <style name="ThemeOverlay.OverlayTimer.Pink" parent=""><item name="colorAccent">@color/bubbleColorPinkLight</item></style>
    <style name="ThemeOverlay.OverlayTimer.Red" parent=""><item name="colorAccent">@color/bubbleColorRedLight</item></style>
</resources>
